# --- Web search (Stage 2) ---
# Path to a Google Cloud service-account JSON key with Vision API enabled.
GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json

# --- Blockchain (Stage 3) ---
# "local"   = free, instant, in-memory chain via eth-tester (default, no keys needed)
# "testnet" = real Sepolia testnet via an RPC provider
BLOCKCHAIN_MODE=local

# Only needed if BLOCKCHAIN_MODE=testnet:
WEB3_PROVIDER_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
PRIVATE_KEY=0xyour_testnet_private_key

# Optional: reuse an already-deployed contract instead of redeploying each run
# CONTRACT_ADDRESS=0x...
